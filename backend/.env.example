# ============================================================
# PharmaGestion — Configuration Environnement (Exemple)
# ============================================================

# ── Base de données principale (MySQL / MariaDB) ──────────────
# Exemple MySQL local (XAMPP/WAMP sans mot de passe) :
DB_URL_LOCAL=mysql+pymysql://pharma_user:@localhost:3306/pharma_db
DB_URL_REMOTE=mysql+pymysql://pharma_user:@localhost:3306/pharma_db

# Exemple avec mot de passe :
# DB_URL_LOCAL=mysql+pymysql://root:MOT_DE_PASSE@localhost:3306/pharma_db

# Exemple mode 100% SQLite local hors-ligne :
# DB_URL_LOCAL=sqlite:///./pharmacy_local.db

# ── Sécurité JWT ─────────────────────────────────────────────
# En production, générer une clé aléatoire forte :
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Application ──────────────────────────────────────────────
APP_NAME=PharmaGestion
APP_VERSION=2.0.0
# Utiliser 'development', 'staging' ou 'production'
ENVIRONMENT=development
DEBUG=False

# ── CORS ─────────────────────────────────────────────────────
# En dev: * ou http://localhost:port
# En production: liste séparée par des virgules de domaines autorisés
# Ex: https://pharmagest.vercel.app,https://pharmagest-pnn8.onrender.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# ── Admin initial (Bootstrap de la pharmacie principale) ───────
ADMIN_INITIAL_PASSWORD=CHANGE_ME_INITIAL_STRONG_PASSWORD

# ── Platform admin bootstrap (Optionnel; gérant de la plateforme multi-tenant) ──
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=

